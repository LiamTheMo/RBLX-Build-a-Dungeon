local Shared = game:GetService("ReplicatedStorage").Shared
local Economy = require(Shared.Rules.Economy)
local Balance = require(Shared.Definitions.Balance)

test("vault bonus steps per 100 and caps", function()
	expectEq(Economy.VaultBonus(0), 0, "empty")
	expectEq(Economy.VaultBonus(99), 0, "below 100")
	expectNear(Economy.VaultBonus(100), 0.01, 1e-9, "100")
	expectNear(Economy.VaultBonus(555), 0.05, 1e-9, "555")
	expectNear(Economy.VaultBonus(2000), 0.20, 1e-9, "cap reached")
	expectNear(Economy.VaultBonus(1e9), Balance.Economy.VaultBonusCap, 1e-9, "capped")
	expectEq(Economy.VaultBonus(-5), 0, "negative")
	expectEq(Economy.VaultBonus(0 / 0), 0, "nan")
end)

test("win payout: banked without a treasure room, vaulted with bonus with one", function()
	local amount, dest = Economy.WinPayout("Novice", 1000, false)
	expectEq(amount, 20, "no treasure ignores the bonus")
	expectEq(dest, "Bank", "dest")
	amount, dest = Economy.WinPayout("Novice", 0, true)
	expectEq(amount, 20, "empty vault no bonus")
	expectEq(dest, "Vault", "dest")
	expectEq((Economy.WinPayout("Novice", 1000, true)), 22, "10% bonus on 20")
end)

test("win payout rounds down and respects the cap", function()
	expectEq((Economy.WinPayout("ArmoredChallenger", 700, true)), 53, "50 * 1.07 = 53.5")
	expectEq((Economy.WinPayout("ArmoredChallenger", 100000, true)), 60, "50 * 1.20")
	expectEq((Economy.WinPayout("Practice", 100, true)), 10, "10 * 1.01 = 10.1")
	expectEq((Economy.WinPayout("Nobody", 100, true)), 0, "unknown visitor")
end)

test("theft rounds down and never exceeds the vault", function()
	expectEq(Economy.Theft("Novice", 0), 0, "empty vault")
	expectEq(Economy.Theft("Novice", 9), 0, "0.9 rounds down")
	expectEq(Economy.Theft("Novice", 99), 9, "9.9 rounds down")
	expectEq(Economy.Theft("Novice", 100), 10, "10%")
	expectEq(Economy.Theft("ArmoredChallenger", 101), 25, "25.25")
	expectEq(Economy.Theft("Practice", 500), 0, "practice steals nothing")
	expectEq(Economy.Theft("Novice", -50), 0, "negative vault")
	expectEq(Economy.Theft("Nobody", 100), 0, "unknown visitor")
end)

test("upgrade costs end at the max level", function()
	expectEq(Economy.UpgradeCost(1), Balance.Upgrades.Costs[1], "to level 2")
	expectEq(Economy.UpgradeCost(2), Balance.Upgrades.Costs[2], "to level 3")
	expectEq(Economy.UpgradeCost(Balance.Upgrades.MaxLevel), nil, "max")
	expectEq(Economy.UpgradeCost(0), nil, "zero")
	expectEq(Economy.UpgradeCost(1.5), nil, "fraction")
	expectEq(Economy.UpgradeCost("1"), nil, "string")
end)

test("visitor interval depends on the treasure room", function()
	expectEq(Economy.VisitorInterval(false), 30, "plain")
	expectEq(Economy.VisitorInterval(true), 20, "treasure")
end)
